{
  "info": {
    "name": "Problem-specific Heuristic REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "api_key",
      "value": "your_random_key"
    },
    {
      "key": "dataset_id",
      "value": ""
    },
    {
      "key": "run_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Create demo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/datasets/demo"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('dataset_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List datasets",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/datasets"
      }
    },
    {
      "name": "Run experiment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/experiments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dataset_id\": \"{{dataset_id}}\",\n  \"d\": 1,\n  \"reads\": 100,\n  \"sweeps\": 100,\n  \"seed\": 42,\n  \"include_quantum\": false\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('run_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List experiments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/experiments"
      }
    },
    {
      "name": "Read experiment",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/experiments/{{run_id}}"
      }
    }
  ]
}